#!/bin/sh
# a8-gpu-drm-test STEP [--again]: the A8 GPU through powervr, one step at a time.
#   probe     modprobe powervr exp_hw_support=1: the probe powers the GPU, reads its ID and boots
#             the firmware to its alive event; then the render node's GPU ID and heaps
#   compute   Mesa's k_store_lid recording through the DRM ioctls; 32 stores of 0x12345678
#   triangle  Mesa's tri-twiddled recording (TA + 3D); the 64x64 target checked pixel by pixel
#   vk        Mesa live on the real driver: /opt/a8vk/a8-vk-smoke all (Vulkan probe, compute,
#             triangle); PASS = its three RESULT lines PASS
#   display   modprobe apple_adbe_drm: the display pipe driver takes the panel over from simpledrm
#             (bind, the display DART's self-check and its CRCs), then a8-gpu-drm kms: the panel's
#             mode and link (eDP on the iPad mini 4, MIPI DSI on the phones and the iPod), a
#             modeset with colour bars, 30 timed page flips and, with powervr loaded and the DART
#             translating, a powervr buffer scanned out through the display DART. One RESULT line
#             per check, then "RESULT display PASS|FAIL". Needs no GPU step before it.
#   all       probe, compute, triangle, vk, display; stops at the first step that does not pass and
#             skips a step whose files this payload does not carry (no recordings, no /opt/a8vk)
# Each step prints a final RESULT line and runs once per boot (/run/a8-gpu-drm/STEP.done); --again repeats
# a step that passed. After a step that failed, or with the GPU left alone ("left as it is" in the
# kernel log: Fender stuck, Apple panics there), nothing more runs on this boot.
# Every step runs under a 30 s hardware watchdog, disarmed when the step ends: a frozen SoC resets.
# The kernel's lines of each step are saved to /run/a8-gpu-drm/STEP.txt, and every kernel line is
# streamed here ("kmsg: ...") while the step runs, so the last one survives a frozen SoC.
D=/run/a8-gpu-drm
SHARE=/usr/share/a8-gpu-drm
mkdir -p "$D"
step=${1:-}
[ $# -gt 0 ] && shift
again=
params=
for a in "$@"; do
    case $a in
    --again) again=--again ;;
    *) echo "unknown argument $a"; exit 2 ;;
    esac
done

refuse() {
    echo "RESULT $step REFUSED $*"
    exit 1
}

case $step in
probe|compute|triangle|vk|display) ;;
all)
    for s in probe compute triangle vk display; do
        if [ -e "$D/$s.done" ]; then echo "RESULT $s PASS (earlier on this boot)"; continue; fi
        case $s in
        compute|triangle) [ -f "$SHARE/$s.rpl" ] || { echo "RESULT $s SKIPPED (no $SHARE/$s.rpl)"; continue; } ;;
        vk) [ -x /opt/a8vk/a8-vk-smoke ] || { echo "RESULT vk SKIPPED (no /opt/a8vk/a8-vk-smoke)"; continue; } ;;
        esac
        "$0" "$s" || exit 1
    done
    exit 0 ;;
*) echo "usage: a8-gpu-drm-test probe|compute|triangle|vk|display|all [--again]"; exit 2 ;;
esac

[ -e "$D/FAILED" ] && refuse "a step failed on this boot ($(cat "$D/FAILED")): reboot first"
dmesg | grep -q 'left as it is' && refuse "the kernel left the GPU alone (Fender stuck): reboot (DFU)"
[ -e "$D/$step.done" ] && [ "$again" != --again ] && refuse "already passed on this boot (--again repeats it)"
if [ "$step" != probe ] && [ "$step" != display ] && ! grep -q '^powervr ' /proc/modules; then
    refuse "powervr is not loaded: run a8-gpu-drm-test probe first"
fi
if [ "$step" = vk ]; then
    [ -x /opt/a8vk/a8-vk-smoke ] || refuse "no /opt/a8vk/a8-vk-smoke in this initramfs"
    [ -c /dev/dri/renderD128 ] || refuse "no /dev/dri/renderD128 (devtmpfs)"
    [ -d /sys/class/drm ] || refuse "/sys is not mounted"
fi
case $step in
compute|triangle) [ -f "$SHARE/$step.rpl" ] || refuse "no $SHARE/$step.rpl in this initramfs" ;;
esac

# display: the board's panel, from the device tree; the boot framebuffer simpledrm runs on
be32() { set -- $(od -An -tu1 "$1" 2>/dev/null); [ $# -eq 4 ] && echo $(( ($1 << 24) | ($2 << 16) | ($3 << 8) | $4 )); }
if [ "$step" = display ]; then
    board=
    for c in $(tr '\0' ' ' < /proc/device-tree/compatible); do
        case $c in apple,n102|apple,n61|apple,n56|apple,j96|apple,j97) board=${c#apple,}; break ;; esac
    done
    case $board in
    n102) panel="640 1136 DSI" ;;
    n61) panel="750 1334 DSI" ;;
    n56) panel="1080 1920 DSI" ;;
    j96|j97) panel="1536 2048 eDP" ;;
    *) refuse "not an A8 board this step knows: $(tr '\0' ' ' < /proc/device-tree/compatible)" ;;
    esac
    km=/lib/modules/$(uname -r)/kernel/drivers/gpu/drm/adbe/apple_adbe_drm.ko
    [ -f "$km" ] || grep -q '^apple_adbe_drm ' /proc/modules || refuse "no $km in this initramfs"
    [ -x /usr/bin/a8-gpu-drm ] || refuse "no /usr/bin/a8-gpu-drm"
    bootfb=
    for f in /proc/device-tree/chosen/framebuffer*; do
        [ -f "$f/width" ] && bootfb="$(be32 "$f/width")x$(be32 "$f/height")" && break
    done
    echo "board $board: expect a $(echo $panel | awk '{print $1"x"$2" "$3}') panel; boot framebuffer ${bootfb:-not described}"
    grep -q ' /sys/kernel/debug ' /proc/mounts || mount -t debugfs -o nosuid,nodev,noexec debugfs /sys/kernel/debug 2>/dev/null
fi

wd=
for d in /dev/watchdog0 /dev/watchdog; do [ -c "$d" ] && { wd=$d; break; }; done
[ -z "$wd" ] && [ "$NO_WATCHDOG" != 1 ] && refuse "no /dev/watchdog: a hang would leave no reset (NO_WATCHDOG=1 runs anyway)"

marker="A8-GPU-DRM $step $$ begin"
# live: every kernel line from here on, before anything touches the GPU
(seen=0; while read -r l; do
    case $l in *"$marker"*) seen=1 ;; esac
    [ $seen = 1 ] && echo "kmsg: ${l#*;}"
done < /dev/kmsg) &
fwd=$!
sleep 1
echo "$marker" > /dev/kmsg
wdpid=
if [ -n "$wd" ]; then
    watchdog -F -T 30 -t 3600 "$wd" </dev/null >/dev/null 2>&1 &
    wdpid=$!
    sleep 1
    kill -0 $wdpid 2>/dev/null || { wdpid=; echo "watchdog failed to arm"; }
fi

out=$D/$step.out
case $step in
probe)
    if grep -q '^powervr ' /proc/modules; then
        echo "powervr already loaded"
    else
        echo "modprobe powervr exp_hw_support=1$params"
        if ! modprobe powervr exp_hw_support=1 $params && ! grep -q '^powervr ' /proc/modules; then
            # without a working modprobe: the dependencies modules.dep names, then powervr
            m=/lib/modules/$(uname -r)
            deps=$(sed -n 's|^\(.*/powervr.ko\):\(.*\)|\2|p' "$m/modules.dep")
            for k in $deps $deps; do insmod "$m/$k" 2>/dev/null; done
            insmod "$m/kernel/drivers/gpu/drm/imagination/powervr.ko" exp_hw_support=1 $params
        fi
        echo "powervr loaded: $(grep -c '^powervr ' /proc/modules)"
    fi
    sleep 1
    a8-gpu-drm info > "$out" 2>&1 ;;
compute)
    a8-gpu-drm compute "$SHARE/compute.rpl" > "$out" 2>&1 ;;
triangle)
    a8-gpu-drm triangle "$SHARE/triangle.rpl" > "$out" 2>&1 ;;
vk)
    /opt/a8vk/a8-vk-smoke all > "$out" 2>&1 ;;
display)
    {
    since() { dmesg | sed -n "/$marker/,\$p"; }
    # the driver's own lines: from this step, or from the boot if it was loaded before (--again)
    klog() { since; }
    strip() { sed -n '1s/^\[[^]]*\] //p'; }
    if grep -q '^apple_adbe_drm ' /proc/modules; then
        echo "apple_adbe_drm already loaded"
        klog() { dmesg; }
    else
        echo "modprobe apple_adbe_drm"
        modprobe apple_adbe_drm || grep -q '^apple_adbe_drm ' /proc/modules || insmod "$km"
    fi
    # the probe runs inside modprobe; a deferred one gets 8 s
    i=0
    while [ $i -lt 8 ] && ! klog | grep -q -e '\[drm\] Initialized adbe' -e 'pipe is not running as iBoot'; do
        sleep 1
        i=$((i + 1))
    done
    dfail=0
    bound=$(klog | grep '\[drm\] Initialized adbe' | strip)
    if [ -z "$bound" ]; then
        why=$(klog | grep -e 'apple-adbe' -e 'adbe' | grep -v 'A8-GPU-DRM' | tail -1 | strip)
        echo "RESULT display-bind FAIL ${why:-no adbe card after 8 s}"
        dfail=1
    else
        echo "RESULT display-bind PASS $bound"
        if klog | grep -q 'display DART self-check passed' && klog | grep -q 'scanout through the display DART'; then
            skip=
            echo "RESULT display-dart PASS $(klog | grep 'scanout through the display DART' | strip)"
        else
            skip=bypass
            why=$(klog | grep -e 'display DART self-check' -e 'translated scanout unavailable' -e 'display DART back in bypass' | tail -1 | strip)
            echo "RESULT display-dart BYPASS ${why:-no display DART self-check ran}"
        fi
        set -- $(klog | grep -o 'pattern crc [0-9a-f]* translated [0-9a-f]* permuted [0-9a-f]*' | head -1)
        if [ $# -eq 7 ]; then
            # "pattern crc P translated T permuted Q": P = T, and Q differs, or the CRC is not live
            ref=
            if [ "$board" = n102 ]; then
                [ "$3 $7" = "cf800572 6c333701" ] && ref=" (equal to the iPod touch 6's reference)" ||
                    ref=" (the iPod touch 6's reference is cf800572/6c333701)"
            fi
            if [ "$3" = 00000000 ]; then
                echo "RESULT display-crc SKIPPED (the self-check read no CRC: pattern $3, translated $5, permuted $7)"
            elif [ "$3" = "$5" ] && [ "$3" != "$7" ]; then
                echo "RESULT display-crc PASS blend CRC: pattern $3, translated $5, permuted $7$ref"
            else
                echo "RESULT display-crc MISMATCH blend CRC: pattern $3, translated $5, permuted $7 (the DART stays in bypass)"
            fi
        else
            echo "RESULT display-crc SKIPPED (no self-check CRC in the kernel log; the driver has no other CRC readback)"
        fi
        [ -z "$skip" ] && ! grep -q '^powervr ' /proc/modules && skip=nogpu
        a8-gpu-drm kms $panel $skip || dfail=1
        bad=$(since | grep -e 'flip not acknowledged' -e 'pipe error bits' -e 'DART.*fault' -e 'SMMU.*fault' \
                  -e 'Unable to handle' -e 'Internal error' -e 'BUG:' -e 'WARNING:' -e 'deprecated workqueue' |
              grep -v -e 'self-check' | head -3)
        if [ -n "$bad" ]; then
            echo "RESULT display-kernel FAIL $(echo "$bad" | strip)"
            dfail=1
        else
            echo "RESULT display-kernel PASS no flip timeout, pipe error, DART fault or warning"
        fi
    fi
    [ $dfail = 0 ]
    } > "$out" 2>&1 ;;
esac
rc=$?
[ -n "$wdpid" ] && { kill -TERM $wdpid; wait $wdpid 2>/dev/null; }
# the runtime suspend's stop comes about 1 s after the probe
[ "$step" = probe ] && sleep 3
kill $fwd 2>/dev/null

if [ "$step" = display ]; then
    dmesg | sed -n "/$marker/,\$p" | grep -i -e adbe -e display -e dart -e smmu -e drm -e simple-framebuffer \
        -e fb0 -e flip -e pipe -e powervr -e 'A8-GPU-DRM' > "$D/$step.txt"
else
    dmesg | sed -n "/$marker/,\$p" | grep -i -e powervr -e 'A8-GPU-DRM' > "$D/$step.txt"
fi
grep -v '^RESULT' "$out"
echo "---- kernel ($D/$step.txt):"
cat "$D/$step.txt"
result=$(grep '^RESULT' "$out" | tail -1)
[ -z "$result" ] && result="RESULT $step FAIL no result (exit $rc)"
if [ "$step" = vk ]; then
    grep '^RESULT' "$out"
    if [ $rc = 0 ] && [ "$(grep -c '^RESULT .* PASS' "$out")" -ge 3 ] && ! grep -q '^RESULT .* FAIL' "$out"; then
        result="RESULT vk PASS (Mesa probe, compute, triangle)"
    else
        result="RESULT vk FAIL (exit $rc; see $out)"
        rc=1
    fi
fi
if [ "$step" = display ]; then
    grep '^RESULT display-' "$out"
    if [ $rc = 0 ]; then
        result="RESULT display PASS ($(grep -c '^RESULT display-.* PASS' "$out") checks passed$(grep -q '^RESULT display-dart BYPASS' "$out" && echo ', display DART in bypass'))"
    else
        result="RESULT display FAIL (see the display- lines above and $D/display.txt)"
        rc=1
    fi
fi
if [ "$step" = probe ]; then
    if [ $rc = 0 ] && grep -q '^RESULT info PASS' "$out"; then
        result="RESULT probe PASS $(grep '^gpu id' "$out")"
    else
        result="RESULT probe FAIL (no powervr render node; see $D/probe.txt)"
        rc=1
    fi
fi
echo "$result"
if [ $rc = 0 ]; then
    : > "$D/$step.done"
elif echo "$result" | grep -q 'FAIL submit '; then
    # Refused by SUBMIT_JOBS: no job reached the GPU, so the step may run again on this boot
    echo "(a submit-time rejection: no GPU work ran; $step can be retried on this boot)"
else
    echo "$step" > "$D/FAILED"
fi
exit $rc
